# Kopieren nach .env und anpassen

# Finnhub (News) – Gratis-Key: https://finnhub.io/register
TH_FINNHUB_API_KEY=
TH_NEWS_LOOKBACK_DAYS=3

# ntfy – Topic-Name möglichst zufällig wählen, wenn ntfy.sh genutzt wird
TH_NTFY_URL=https://ntfy.sh
TH_NTFY_TOPIC=tradehelper-change-me-123
TH_NTFY_TOKEN=

# API – Key setzen, wenn der Server außerhalb deines LANs erreichbar ist
TH_API_HOST=0.0.0.0
TH_API_PORT=8080
TH_API_KEY=

# Zeitplan
TH_TIMEZONE=Europe/Berlin
TH_REPORT_TIME=07:30
TH_ALERT_INTERVAL_MINUTES=5
TH_ALERT_HOURS=8-22
TH_ALERT_COOLDOWN_MINUTES=240

TH_DATA_DIR=./data
